<Window x:Class="CustomGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Launcher" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button Content="➕  Add Folder" Style="{StaticResource ToolButton}"
                        Command="{Binding AddFolderCommand}"/>
                <Button Content="⟳  Refresh" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="🗑  Clear" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/>
                <TextBox DockPanel.Dock="Right" Width="240" Style="{StaticResource SearchBox}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                <TextBlock DockPanel.Dock="Right" Text="🔍" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>

        <!-- Empty-state hint -->
        <TextBlock Grid.Row="1" Text="Click “Add Folder” and pick a folder of games (subfolders are scanned)."
                   Foreground="{StaticResource Muted}" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding EmptyHintVisibility}"/>

        <!-- Game grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
            <ItemsControl ItemsSource="{Binding GamesView}">
                <ItemsControl.ItemsPanel>
                    <!-- WrapPanel = auto-wrap, no manual column math (kills the "4-in-a-row on refresh" bug).
                         For thousands of games, swap this for a VirtualizingWrapPanel (NuGet) to virtualize. -->
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding ExePath}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Set launch file…"
                                              Command="{Binding PlacementTarget.Tag.SetLaunchExeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Open game folder"
                                              Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Remove from list"
                                              Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Width="150">
                                <Grid Width="128" Height="128" HorizontalAlignment="Center">
                                    <Border CornerRadius="12" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                                    <!-- Fallback: first letter shows when no icon has loaded -->
                                    <TextBlock Text="{Binding Initial}" FontSize="46" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Stretch=Uniform keeps aspect ratio — never distorts the icon -->
                                    <Image Source="{Binding Icon}" Stretch="Uniform" Margin="12"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}"
                                           FontSize="12" TextAlignment="Center" Margin="0,7,0,0"
                                           MaxWidth="142" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
